<div class="min-h-screen bg-[#FAF7F4]">
  <div class="max-w-2xl mx-auto px-4 py-10">

    <div class="flex items-center justify-between">

      <h1 class="text-3xl font-extrabold text-slate-800">
        Admin 💛
      </h1>

      <%= link_to "Nieuwe aanvraag",
            new_admin_request_path,
            class: "text-white px-5 py-3 rounded-full font-bold transition",
            style: "background-color: #D4A017;" %>

    </div>

    <div class="mt-8 flex flex-col gap-5">

      <% @requests.each do |request| %>

        <div class="bg-white rounded-3xl p-6 shadow-sm">

          <p class="font-bold text-sm uppercase" style="color: #A65E00;">
            <%= l(request.date, format: :long).capitalize %>
          </p>

          <h2 class="mt-2 text-2xl font-bold text-slate-800">
            <%= request.title %>
          </h2>

          <% if request.volunteer_name.present? %>

            <div class="mt-4 bg-green-50 text-green-700 rounded-2xl px-4 py-3">
              💛 <%= request.volunteer_name %> helpt hierbij
            </div>

            <%= button_to "Opnieuw beschikbaar maken",
                  remove_volunteer_request_path(request),
                  method: :patch,
                  class: "mt-3 font-semibold",
                  style: "color: #055635;" %>

          <% end %>

         <div class="mt-3">
            <%= link_to "Bewerken",
                  edit_admin_request_path(request),
                  class: "font-semibold",
                  style: "color: #A65E00;" %>
          </div>

          <div class="mt-3">

            <%= button_to "Aanvraag verwijderen",
                  admin_request_path(request),
                  method: :delete,
                  class: "font-semibold",
                  style: "color: #a60000;" %>

          </div>

        </div>

      <% end %>

    </div>

  </div>
</div>
