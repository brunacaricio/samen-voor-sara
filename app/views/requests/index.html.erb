<div class="min-h-screen bg-[#FAF7F4] overflow-hidden">

    <div class="px-5 py-8">

    <div class="text-center">

      <%= image_tag "sunflower.png",
      alt: "Sunflower",
      class: "mx-auto",
      size: "80x80" %>

      <h1 class="mt-5 text-4xl font-extrabold text-slate-800 leading-tight">
        Samen voor Sara
      </h1>

      <p class="mt-4 text-slate-600 leading-snug text-lg">Alles is vrijblijvend.</br>Bedankt om mee te helpen</br>op de momenten die voor jou passen.</p>

    </div>

    <div class="mt-10 mb-2 text-center">

<div
  class="inline-flex items-center gap-2 px-5 py-3 rounded-full shadow-sm"
  style="
    background-color: #FFF4CC;
    color: #A65E00;
">
  <span class="text-base">🌻</span>
  <span><b>KOMENDE HULPMOMENTEN</b></span>
</div>

    </div>

    <div class="mt-10 flex flex-col gap-5">

      <% @requests.each do |request| %>

        <%= turbo_frame_tag dom_id(request), class: "block" do %>
          <%= render "request", request: request %>
        <% end %>

      <% end %>

    </div>
  </div>
</div>
