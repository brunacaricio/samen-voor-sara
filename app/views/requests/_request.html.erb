<div class="bg-white rounded-[28px] p-6 shadow-sm border border-white/50">

  <p class="text-pink-500 font-bold uppercase tracking-wide text-sm">
    <%= l(request.date, format: :long).capitalize %>
  </p>

  <h2 class="mt-2 text-2xl font-extrabold text-slate-800 leading-snug">
    <%= request.title %>
  </h2>

  <div class="mt-4 space-y-1 text-slate-500">

    <p>
      🕒 <%= request.start_time %> - <%= request.end_time %>
    </p>

    <% if request.location.present? %>
      <p>
        📍 <%= request.location %>
      </p>
    <% end %>

    <% if request.note.present? %>

      <div class="mt-4 bg-[#FAF7F4] rounded-2xl p-4 text-slate-600 leading-relaxed">
        <%= request.note %>
      </div>

    <% end %>

  </div>

  <% if request.volunteer_name.present? %>

    <div class="mt-6 bg-green-50 text-green-700 rounded-full px-4 py-3 text-center font-bold">
      💛 <%= request.volunteer_name %> helpt hierbij
    </div>

  <% else %>

   <button
      onclick="document.getElementById('modal-<%= request.id %>').classList.remove('hidden')"
      class="w-full bg-pink-400 hover:bg-pink-500 transition mt-4 text-white font-bold py-4 rounded-full cursor-pointer">
      Ik wil helpen
    </button>

    <div id="modal-<%= request.id %>"class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm px-5">

      <div class="bg-white rounded-[32px] p-6 w-full max-w-sm shadow-xl">

        <div class="flex items-center justify-between mb-5">

          <h3 class="text-xl font-bold text-slate-800">
            Ik wil helpen 💛
          </h3>

          <button
            onclick="document.getElementById('modal-<%= request.id %>').classList.add('hidden')"
            class="text-slate-400 text-2xl leading-none"
          >
            ×
          </button>

        </div>

        <%= form_with url: volunteer_request_path(request),
              method: :patch,
              local: true do |f| %>

          <%= f.text_field :volunteer_name,
                placeholder: "Jouw naam",
                class: "w-full rounded-2xl border border-slate-200 px-4 py-3 mb-4" %>

          <%= f.text_area :volunteer_note,
                placeholder: "Extra bericht (optioneel)",
                rows: 3,
                class: "w-full rounded-2xl border border-slate-200 px-4 py-3 mb-5 resize-none" %>

          <%= f.submit "Bevestigen",
                class: "w-full bg-pink-400 hover:bg-pink-500 transition text-white font-bold py-4 rounded-full cursor-pointer" %>

        <% end %>

      </div>

    </div>

  <% end %>

</div>
